<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SSL Certificate Inspector</title>
    <link rel="stylesheet" href="/static/bootstrap.min.css">
    <link rel="stylesheet" href="/static/bootstrap-icons.css">
    <style>
        html, body { height: 100%; margin: 0; }
        body { display: flex; flex-direction: column; background-color: #f8f9fa; font-family: sans-serif; }
        .content-wrapper { flex: 1 0 auto; }
        .card { border: none; border-radius: 10px; box-shadow: 0 0.125rem 0.25rem rgba(0,0,0,0.075); }
        .details-label { font-weight: bold; color: #6c757d; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.5px; }
        .details-value { font-family: 'Courier New', monospace; font-size: 0.9rem; color: #212529; word-break: break-all; }
        .badge-eku { background-color: #e0f7fa; color: #006064; border: 1px solid #b2ebf2; font-weight: normal; }
        pre.pem-block { 
            background-color: #212529; 
            color: #f8f9fa; 
            padding: 15px; 
            border-radius: 5px; 
            font-size: 0.8rem; 
            white-space: pre-wrap; 
            word-break: break-all;
            font-family: monospace;
        }
        footer { flex-shrink: 0; background-color: #ffffff; border-top: 1px solid #dee2e6; }
        .cursor-pointer { cursor: pointer; }
    </style>
</head>
<body>

<div class="content-wrapper">
    <div class="container py-4">
        <h2 class="mb-4 text-primary"><i class="bi bi-shield-lock-fill"></i> SSL Inspector</h2>

        <div class="card p-4 mb-4">
            <form method="POST" class="row g-3">
                <div class="col-md-8">
                    <label class="form-label fw-bold">Hostname / FQDN</label>
                    <input type="text" name="server_host" class="form-control" value="{{ host if host else '' }}" required>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold">Port</label>
                    <input type="number" name="server_port" class="form-control" value="{{ port }}">
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">Prüfen</button>
                </div>
            </form>
        </div>

        {% if error %}
        <div class="alert alert-danger">{{ error }}</div>
        {% endif %}

        {% if data %}
        <div class="card mb-3">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Ergebnis für <span class="text-primary">{{ host }}</span></h5>
                <span class="badge {{ 'bg-success' if data.valid else 'bg-danger' }} rounded-pill px-3">
                    {{ 'VALIDE' if data.valid else 'UNGÜLTIG' }}
                </span>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-7">
                        <div class="mb-3">
                            <div class="details-label">Subject</div>
                            <div class="details-value">{{ data.subject }}</div>
                        </div>
                        <div class="mb-3">
                            <div class="details-label">Issuer</div>
                            <div class="details-value">{{ data.issuer }}</div>
                        </div>
                        <div class="mb-3">
                            <div class="details-label">Subject Alternative Names (SANs)</div>
                            <div class="details-value small text-muted">{{ data.sans | join(', ') }}</div>
                        </div>
                        <div class="mb-3">
                            <div class="details-label">Key Usage</div>
                            <div class="details-value">
                                {% for u in data.usage %}<span class="badge bg-light text-dark border me-1">{{ u }}</span>{% endfor %}
                            </div>
                        </div>
                        <div class="mb-3">
                            <div class="details-label">Extended Key Usage</div>
                            <div class="details-value">
                                {% for eu in data.extended_usage %}<span class="badge badge-eku me-1">{{ eu }}</span>{% endfor %}
                            </div>
                        </div>
                    </div>
                    <div class="col-md-5 border-start">
                        <div class="mb-3">
                            <div class="details-label">Public Key Algorithm</div>
                            <div class="details-value">{{ data.pk_algo }} <br><small class="text-muted">{{ data.key_info }}</small></div>
                        </div>
                        <div class="mb-3">
                            <div class="details-label">Signature Algorithm</div>
                            <div class="details-value fw-bold text-primary">{{ data.sig_alg }}</div>
                        </div>
                        <div class="mb-3">
                            <div class="details-label">Gültigkeit bis</div>
                            <div class="details-value">{{ data.until }} ({{ data.days }} Tage verbleibend)</div>
                        </div>
                        <div class="mb-3">
                            <div class="details-label">Protokoll</div>
                            <div class="details-value">{{ data.tls }}</div>
                        </div>
                        <div class="mb-0">
                            <div class="details-label">Seriennummer</div>
                            <div class="details-value small">{{ data.serial }}</div>
                        </div>
                    </div>
                </div>

                <hr class="my-4">
                <h6 class="text-muted mb-3 fw-bold">Zertifikatskette</h6>
                {% if chain %}
                    {% for cert in chain %}
                    <details class="mb-2 border rounded" {{ 'open' if loop.first else '' }}>
                        <summary class="p-2 bg-light cursor-pointer small fw-bold">{{ cert.sub }}</summary>
                        <div class="p-3 bg-white">
                            <div class="mb-2 small"><strong>Issuer:</strong> {{ cert.iss }}</div>
                            <pre class="pem-block">{{ cert.pem }}</pre>
                        </div>
                    </details>
                    {% endfor %}
                {% endif %}
            </div>
        </div>
        {% endif %}
    </div>
</div>

<footer class="text-center text-muted py-3 mt-auto">
    <div class="container small">SSL Inspector &bull; {{ now }} &bull; &copy; 2026 hergla</div>
</footer>

</body>
</html>

